---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import MessageButtons from "../components/MessageButtons.astro";
import { bakeries, SITE } from "../data/bakeries";
import headerImg from "../assets/photos/vitrine-patisseries.jpg";

const title = "Commandes sur mesure — gâteaux et plateaux | MK Boulangeries";
const description =
  "Gâteaux d'anniversaire, plateaux de pâtisseries orientales, commandes pour vos fêtes. Comment commander, quels délais prévoir, dans nos boulangeries à Nantes et Saint-Herblain.";

const etapes = [
  {
    n: "01",
    titre: "Dites-nous ce que vous voulez",
    texte:
      "Le nombre de parts, le parfum, la date et l'heure de retrait. Un message écrit va souvent plus vite qu'un appel : vous prenez le temps de tout préciser, on répond dès qu'on sort du fournil.",
  },
  {
    n: "02",
    titre: "On confirme ce qui est faisable",
    texte:
      "Selon la période et la pièce demandée, on vous dit tout de suite si c'est jouable pour la date voulue, et ce qu'on peut proposer d'autre si ce n'est pas le cas.",
  },
  {
    n: "03",
    titre: "Vous retirez en boutique",
    texte:
      "À la boulangerie de votre choix, à l'heure convenue. On garde la commande au frais jusqu'au retrait.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Commandes de gâteaux et plateaux sur mesure",
  serviceType: "Commande de pâtisserie sur mesure",
  description,
  areaServed: ["Nantes", "Saint-Herblain"],
  provider: bakeries.map((b) => ({
    "@type": "Bakery",
    "@id": `${SITE.domain}/${b.slug}#bakery`,
    name: b.name,
  })),
};
---

<Base title={title} description={description} canonical="/commandes" jsonLd={jsonLd}>
  <Nav current="commandes" />

  <header class="page-hero">
    <div class="page-hero-media" data-parallax="0.14">
      <Image src={headerImg} alt="Vitrine de pâtisseries fines dans une boulangerie" widths={[760, 1400]} sizes="100vw" loading="eager" />
    </div>
    <div class="page-hero-overlay"></div>
    <div class="page-hero-content" id="contenu">
      <span class="surtitre">Commandes sur mesure</span>
      <h1 class="serif">Pour les jours<br /><span class="italic">qui comptent</span></h1>
      <p>
        Anniversaires, fêtes de famille, Ramadan, réunions au bureau. On prépare
        la commande à l'avance, vous n'avez plus qu'à passer la chercher.
      </p>
    </div>
  </header>

  <main>
    <section class="what">
      <div class="what-grid">
        <article class="what-card" data-reveal>
          <span class="diamond diamond-lg"></span>
          <h2 class="serif">Gâteaux d'anniversaire</h2>
          <p>De 6 à 30 parts et au-delà. Parfums classiques ou entremets, avec inscription si vous le souhaitez.</p>
        </article>
        <article class="what-card" data-reveal style="transition-delay:.08s">
          <span class="diamond diamond-lg"></span>
          <h2 class="serif">Plateaux orientaux</h2>
          <p>Cornes de gazelle, baklawas, makrouts, en assortiment ou par variété. Très demandés pendant le Ramadan et les fêtes.</p>
        </article>
        <article class="what-card" data-reveal style="transition-delay:.16s">
          <span class="diamond diamond-lg"></span>
          <h2 class="serif">Buffets & pièces salées</h2>
          <p>Plateaux de sandwichs, quiches et pièces à partager pour une réunion, un pot ou un événement de famille.</p>
        </article>
      </div>
    </section>

    <section class="steps">
      <div class="section-head" data-reveal>
        <span class="surtitre">Comment ça marche</span>
        <h2 class="serif">Trois étapes, pas plus</h2>
      </div>
      <ol class="steps-list">
        {etapes.map((e, i) => (
          <li class="step" data-reveal style={`transition-delay:${i * 0.09}s`}>
            <span class="step-n serif">{e.n}</span>
            <div>
              <h3 class="serif">{e.titre}</h3>
              <p>{e.texte}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="delays">
      <div class="delays-inner" data-reveal>
        <h2 class="serif">Quels délais prévoir&nbsp;?</h2>
        <p class="delays-lead">
          <strong>48 heures au minimum</strong> pour un gâteau ou un plateau
          classique. Comptez plus large pour les grandes pièces, les week-ends,
          et les périodes de forte demande — Ramadan, fêtes de fin d'année.
        </p>
        <p class="delays-note">
          Le plus simple reste d'appeler ou d'écrire dès que la date est connue :
          on vous dira franchement si c'est faisable.
        </p>
      </div>
    </section>

    <section class="contact">
      <div class="contact-inner" data-reveal>
        <span class="diamond"></span>
        <h2 class="serif">Lancer une commande</h2>
        <p>
          Écrivez-nous en précisant la boulangerie, la date et ce que vous
          souhaitez. On vous répond aux heures d'ouverture.
        </p>

        <MessageButtons
          message="Bonjour, je souhaite commander pour le [date] : [nombre de parts / type de gâteau ou plateau], à retirer à [boulangerie]."
          shop="commandes"
        />

        <div class="contact-tels">
          {bakeries.map((b) => (
            <a href={b.phoneHref} class="contact-tel" style={`--accent:${b.accent}`} data-shop={b.slug} data-phone={b.phone}>
              <span class="contact-tel-name">{b.name}</span>
              <span class="contact-tel-num">{b.phone}</span>
              <span class="contact-tel-meta">{b.street}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .page-hero { position: relative; overflow: hidden; isolation: isolate; padding: 190px 40px 100px; text-align: center; }
  .page-hero-media { position: absolute; inset: -12% 0 -12% 0; z-index: -2; will-change: transform; }
  .page-hero-media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .page-hero-overlay {
    position: absolute; inset: 0; z-index: -1;
    background:
      radial-gradient(ellipse at 50% 45%, rgba(10, 14, 12, 0.55) 0%, rgba(10, 14, 12, 0.9) 72%),
      linear-gradient(to bottom, rgba(14, 19, 16, 0.5) 0%, rgba(14, 19, 16, 0.25) 40%, var(--bg) 97%);
  }
  .page-hero-content { position: relative; max-width: 760px; margin: 0 auto; }
  .page-hero h1 { font-weight: 600; font-size: clamp(38px, 6.5vw, 74px); line-height: 1.06; margin: 18px 0 24px; text-shadow: 0 2px 30px rgba(0, 0, 0, 0.5); }
  .italic { font-style: italic; color: var(--accent); }
  .page-hero p { font-size: 17px; line-height: 1.75; color: #cfc9bd; margin: 0; }

  .what { padding: 90px 40px 0; }
  .what-grid { max-width: 1150px; margin: 0 auto; display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .what-card {
    background: var(--surface); border: 1px solid var(--line); border-radius: 6px;
    padding: 44px 36px;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.3s ease-out;
  }
  .what-card:hover { transform: translateY(-5px); border-color: color-mix(in srgb, var(--accent) 40%, transparent); }
  .what-card h2 { font-size: 23px; font-weight: 600; margin: 0 0 14px; }
  .what-card p { font-size: 15px; line-height: 1.7; color: var(--muted); margin: 0; }

  .steps { padding: 100px 40px 0; }
  .section-head { max-width: 1150px; margin: 0 auto 48px; text-align: center; }
  .section-head h2 { font-weight: 600; font-size: clamp(28px, 4.4vw, 44px); margin: 18px 0 0; }
  .steps-list { list-style: none; max-width: 860px; margin: 0 auto; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  .step {
    display: flex; gap: 28px; align-items: flex-start;
    padding: 34px 36px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .step-n { font-size: 30px; color: var(--accent); line-height: 1; opacity: 0.75; flex-shrink: 0; }
  .step h3 { font-size: 20px; font-weight: 600; margin: 0 0 10px; }
  .step p { font-size: 15px; line-height: 1.75; color: var(--muted); margin: 0; }

  .delays { padding: 100px 40px 0; }
  .delays-inner {
    max-width: 780px; margin: 0 auto; padding: 52px 44px;
    border-left: 2px solid var(--accent);
    background: linear-gradient(to right, rgba(255, 255, 255, 0.03), transparent);
  }
  .delays-inner h2 { font-weight: 600; font-size: clamp(26px, 4vw, 36px); margin: 0 0 20px; }
  .delays-lead { font-size: 17px; line-height: 1.8; color: var(--ink); margin: 0 0 16px; }
  .delays-lead strong { color: var(--accent); }
  .delays-note { font-size: 15px; line-height: 1.75; color: var(--muted); margin: 0; }

  .contact { padding: 100px 40px 110px; text-align: center; }
  .contact-inner {
    max-width: 880px; margin: 0 auto; padding: 64px 44px;
    background: var(--surface); border: 1px solid var(--line); border-radius: 6px;
    display: flex; flex-direction: column; align-items: center;
  }
  .contact-inner h2 { font-weight: 600; font-size: clamp(28px, 4.4vw, 42px); margin: 26px 0 16px; }
  .contact-inner > p { font-size: 16px; line-height: 1.75; color: var(--muted); max-width: 52ch; margin: 0 0 32px; }
  .contact-tels { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; width: 100%; margin-top: 38px; padding-top: 34px; border-top: 1px solid var(--line); }
  .contact-tel { display: flex; flex-direction: column; gap: 5px; padding: 18px 16px; border: 1px solid var(--line); border-radius: 4px; transition: border-color 0.25s ease-out; }
  .contact-tel:hover { border-color: var(--accent); }
  .contact-tel-name { font-size: 13px; color: var(--muted); }
  .contact-tel-num { font-family: "Playfair Display", serif; font-size: 19px; color: var(--accent); }
  .contact-tel-meta { font-size: 12px; color: var(--muted); }

  @media (max-width: 980px) {
    .what-grid { grid-template-columns: 1fr; max-width: 560px; }
    .contact-tels { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .page-hero { padding: 150px 24px 80px; }
    .what { padding: 70px 24px 0; }
    .steps, .delays { padding: 70px 24px 0; }
    .step { flex-direction: column; gap: 14px; padding: 28px 26px; }
    .delays-inner { padding: 36px 26px; }
    .contact { padding: 70px 24px 80px; }
    .contact-inner { padding: 44px 26px; }
  }
</style>
