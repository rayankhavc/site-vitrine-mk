---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import MessageButtons from "../components/MessageButtons.astro";
import { faq } from "../data/products";
import { bakeries } from "../data/bakeries";

const title = "Questions fréquentes — horaires, commandes, adresses | MK Boulangeries";
const description =
  "Horaires d'ouverture, jour de fermeture, commandes de gâteaux et de plateaux orientaux, adresses de nos trois boulangeries à Nantes et Saint-Herblain.";

// FAQPage : c'est le format que Google affiche directement dans ses
// résultats, et celui que les assistants IA citent le plus volontiers.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Base title={title} description={description} canonical="/faq" jsonLd={jsonLd}>
  <Nav current="faq" />

  <header class="page-head" id="contenu">
    <span class="surtitre">Questions fréquentes</span>
    <h1 class="serif">Les questions<br /><span class="italic">qu'on nous pose</span></h1>
    <p>
      Les réponses aux questions posées au comptoir tous les jours. Si la
      vôtre n'y est pas, appelez-nous ou écrivez-nous.
    </p>
  </header>

  <main class="faq-wrap">
    <div class="faq-list">
      {faq.map((f, i) => (
        <details class="faq-item" data-reveal style={`transition-delay:${Math.min(i, 6) * 0.05}s`}>
          <summary>
            <h2>{f.q}</h2>
            <span class="chev" aria-hidden="true"></span>
          </summary>
          <div class="faq-answer"><p>{f.a}</p></div>
        </details>
      ))}
    </div>

    <aside class="faq-aside" data-reveal>
      <h2 class="serif">Une autre question&nbsp;?</h2>
      <p>Écrivez-nous, on répond aux heures d'ouverture.</p>
      <MessageButtons message="Bonjour, j'ai une question :" shop="faq" compact />

      <div class="aside-tels">
        {bakeries.map((b) => (
          <a href={b.phoneHref} class="aside-tel" style={`--accent:${b.accent}`} data-shop={b.slug} data-phone={b.phone}>
            <span class="aside-tel-name">{b.name}</span>
            <span class="aside-tel-num">{b.phone}</span>
          </a>
        ))}
      </div>
    </aside>
  </main>

  <Footer />
</Base>

<style>
  .page-head { max-width: 780px; margin: 0 auto; padding: 180px 40px 70px; text-align: center; }
  .page-head h1 { font-weight: 600; font-size: clamp(38px, 6.5vw, 70px); line-height: 1.06; margin: 18px 0 22px; }
  .italic { font-style: italic; color: var(--accent); }
  .page-head p { font-size: 17px; line-height: 1.75; color: var(--muted); margin: 0; }

  .faq-wrap {
    max-width: 1150px; margin: 0 auto; padding: 0 40px 110px;
    display: grid; grid-template-columns: 1.6fr 1fr; gap: 54px; align-items: start;
  }

  .faq-list { display: flex; flex-direction: column; gap: 12px; }
  .faq-item {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
    transition: border-color 0.25s ease-out;
  }
  .faq-item[open] { border-color: color-mix(in srgb, var(--accent) 40%, transparent); }
  .faq-item summary {
    list-style: none; cursor: pointer;
    display: flex; align-items: center; justify-content: space-between; gap: 20px;
    padding: 22px 26px;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item h2 { font-size: 16px; font-weight: 500; margin: 0; line-height: 1.5; }

  .chev {
    position: relative; width: 12px; height: 12px; flex-shrink: 0;
    transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .chev::before, .chev::after {
    content: ""; position: absolute; background: var(--accent);
    transition: opacity 0.25s ease-out;
  }
  .chev::before { top: 5px; left: 0; width: 12px; height: 2px; }
  .chev::after { left: 5px; top: 0; width: 2px; height: 12px; }
  .faq-item[open] .chev { transform: rotate(90deg); }
  .faq-item[open] .chev::after { opacity: 0; }

  .faq-answer { padding: 0 26px 24px; }
  .faq-answer p { font-size: 15px; line-height: 1.8; color: var(--muted); margin: 0; }

  .faq-aside {
    position: sticky; top: 100px;
    background: var(--surface); border: 1px solid var(--line); border-radius: 6px;
    padding: 36px 32px;
  }
  .faq-aside h2 { font-size: 24px; font-weight: 600; margin: 0 0 12px; }
  .faq-aside > p { font-size: 15px; line-height: 1.7; color: var(--muted); margin: 0 0 22px; }

  .aside-tels { display: flex; flex-direction: column; gap: 10px; margin-top: 26px; padding-top: 24px; border-top: 1px solid var(--line); }
  .aside-tel { display: flex; flex-direction: column; gap: 3px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 4px; transition: border-color 0.25s ease-out; }
  .aside-tel:hover { border-color: var(--accent); }
  .aside-tel-name { font-size: 12px; color: var(--muted); }
  .aside-tel-num { font-family: "Playfair Display", serif; font-size: 17px; color: var(--accent); }

  @media (max-width: 940px) {
    .faq-wrap { grid-template-columns: 1fr; gap: 36px; }
    .faq-aside { position: static; }
  }
  @media (max-width: 600px) {
    .page-head { padding: 140px 24px 50px; }
    .faq-wrap { padding: 0 24px 80px; }
    .faq-item summary { padding: 18px 20px; }
    .faq-answer { padding: 0 20px 20px; }
  }
</style>
