---
import { SITE } from "../data/bakeries";

interface Props {
  title: string;
  description: string;
  /** Couleur d'accent de la page (chaque boulangerie a la sienne). */
  accent?: string;
  accentSoft?: string;
  canonical: string;
  jsonLd?: object;
}

const {
  title,
  description,
  accent = "#C9A260",
  accentSoft = "#E2B97A",
  canonical,
  jsonLd,
} = Astro.props;

const canonicalUrl = new URL(canonical, SITE.domain).href;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0E1310" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <script is:inline>
      // Les animations d'apparition ne s'appliquent que si le JS tourne.
      // Sans ce garde-fou, un JS en échec laisserait la page entièrement
      // vide : le contenu doit rester lisible en toute circonstance.
      document.documentElement.classList.add("js");
    </script>

    <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.ga}`}></script>
    <script is:inline define:vars={{ gaId: SITE.ga }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("js", new Date());
      gtag("config", gaId);
    </script>
  </head>

  <body style={`--accent:${accent}; --accent-soft:${accentSoft};`}>
    <slot />

    <div id="copy-toast" class="copy-toast" role="status" aria-live="polite"></div>
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }

  :root {
    --bg: #0E1310;
    --bg-deep: #0A0E0C;
    --surface: #161C18;
    --ink: #F0EBE0;
    --muted: #8A8A7A;
    --line: rgba(255, 255, 255, 0.06);
    --closed: #E06060;
    --open: #5AAF7E;
  }

  html { scroll-behavior: smooth; }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: "Inter", system-ui, sans-serif;
    min-height: 100vh;
    /* Laisse la place à la barre d'appel collante sur mobile. */
    padding-bottom: env(safe-area-inset-bottom);
  }

  a { text-decoration: none; color: inherit; }
  img { max-width: 100%; display: block; }

  ::selection { background: color-mix(in srgb, var(--accent) 30%, transparent); }

  :focus-visible {
    outline: 2px solid var(--accent-soft);
    outline-offset: 3px;
  }

  /* ── Scroll reveal ── */
  .js [data-reveal] {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }
  .js [data-reveal].is-visible { opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .js [data-reveal] { opacity: 1; transform: none; transition: none; }
    .hero-word { opacity: 1 !important; animation: none !important; }
    .nav-anim { animation: none; }
  }

  /* ── Typo partagée ── */
  .serif { font-family: "Playfair Display", serif; }

  .surtitre {
    display: block;
    font-size: 12px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--accent);
  }

  .diamond {
    display: inline-block;
    width: 10px;
    height: 10px;
    background: var(--accent);
    transform: rotate(45deg);
    flex-shrink: 0;
  }
  .diamond-lg { width: 14px; height: 14px; margin-bottom: 26px; }

  /* ── Boutons ── */
  .btn-primary,
  .btn-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.3px;
    padding: 15px 32px;
    border-radius: 3px;
    /* Cible tactile confortable : on ne rate pas le bouton d'appel. */
    min-height: 48px;
    transition: background 0.25s ease-out, border-color 0.25s ease-out, color 0.25s ease-out;
  }
  .btn-primary {
    background: var(--accent);
    color: var(--bg-deep);
    border: 1px solid var(--accent);
    font-weight: 600;
  }
  .btn-primary:hover { background: var(--accent-soft); border-color: var(--accent-soft); }
  .btn-outline {
    border: 1px solid rgba(240, 235, 224, 0.45);
    color: var(--ink);
  }
  .btn-outline:hover {
    border-color: var(--ink);
    background: rgba(240, 235, 224, 0.06);
  }

  /* ── Pastille ouvert / fermé, remplie en JS au chargement ── */
  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    letter-spacing: 0.4px;
    color: var(--muted);
  }
  .status[hidden] { display: none; }
  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--muted);
    flex-shrink: 0;
  }
  .status.is-open .status-dot { background: var(--open); box-shadow: 0 0 0 4px rgba(90, 175, 126, 0.15); }
  .status.is-closed .status-dot { background: var(--closed); }
  .status.is-open .status-text { color: var(--open); }
  .status.is-closed .status-text { color: var(--closed); }

  /* ── Toast copie du numéro (ordinateur) ── */
  .copy-toast {
    position: fixed;
    left: 50%;
    bottom: 28px;
    transform: translate(-50%, 16px);
    z-index: 200;
    background: var(--accent);
    color: var(--bg-deep);
    font-size: 14px;
    font-weight: 600;
    padding: 12px 22px;
    border-radius: 4px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease-out, transform 0.25s ease-out;
  }
  .copy-toast.show { opacity: 1; transform: translate(-50%, 0); }
</style>

<script>
  // ── Reveal au scroll ──
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add("is-visible");
          io.unobserve(e.target); // une fois révélé, on n'y revient pas
        }
      });
    },
    { threshold: 0.08, rootMargin: "0px 0px -40px 0px" },
  );
  document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));

  // ── Ouvert / fermé en temps réel ──
  // Les horaires sont sérialisés dans data-hours par le composant Status.
  const PARIS = "Europe/Paris";

  function parisNow() {
    // On lit l'heure de Paris quelle que soit la zone du visiteur.
    const fmt = new Intl.DateTimeFormat("fr-FR", {
      timeZone: PARIS,
      weekday: "short",
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
    });
    const parts = Object.fromEntries(
      fmt.formatToParts(new Date()).map((p) => [p.type, p.value]),
    );
    const days = ["dim", "lun", "mar", "mer", "jeu", "ven", "sam"];
    const idx = days.indexOf(parts.weekday.slice(0, 3).toLowerCase());
    // Nos horaires commencent lundi ; Intl renvoie dimanche = 0.
    const mondayIndex = idx === 0 ? 6 : idx - 1;
    return {
      day: mondayIndex,
      minutes: Number(parts.hour) * 60 + Number(parts.minute),
    };
  }

  const toMinutes = (hhmm: string) => {
    const [h, m] = hhmm.split(":").map(Number);
    return h * 60 + m;
  };

  // "06:00" → "6h", "07:30" → "7h30" : on écrit l'heure comme on la dit.
  const pretty = (hhmm: string) => {
    const [h, m] = hhmm.split(":").map(Number);
    return m === 0 ? `${h}h` : `${h}h${String(m).padStart(2, "0")}`;
  };

  document.querySelectorAll<HTMLElement>("[data-hours]").forEach((el) => {
    const hours = JSON.parse(el.dataset.hours!) as {
      day: string;
      open: string | null;
      close: string | null;
    }[];
    const { day, minutes } = parisNow();
    const today = hours[day];
    const textEl = el.querySelector(".status-text")!;

    if (today?.open && today.close) {
      const open = toMinutes(today.open);
      const close = toMinutes(today.close);
      if (minutes >= open && minutes < close) {
        el.classList.add("is-open");
        textEl.textContent = `Ouvert · ferme à ${pretty(today.close)}`;
      } else if (minutes < open) {
        el.classList.add("is-closed");
        textEl.textContent = `Fermé · ouvre à ${pretty(today.open)}`;
      } else {
        el.classList.add("is-closed");
        textEl.textContent = "Fermé pour aujourd'hui";
      }
    } else {
      el.classList.add("is-closed");
      textEl.textContent = "Fermé aujourd'hui";
    }
    el.hidden = false;
  });

  // ── Liens tél : appel direct sur mobile, copie sur ordinateur ──
  const canDial = window.matchMedia("(hover: none) and (pointer: coarse)").matches;
  const toast = document.getElementById("copy-toast");
  let toastTimer: number | undefined;

  function showToast(msg: string) {
    if (!toast) return;
    toast.textContent = msg;
    toast.classList.add("show");
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => toast.classList.remove("show"), 2600);
  }

  document.querySelectorAll<HTMLAnchorElement>('a[href^="tel:"]').forEach((link) => {
    link.addEventListener("click", async (e) => {
      // Mesure l'intention d'appel : c'est LA conversion de ce site.
      const shop = link.dataset.shop ?? "inconnu";
      (window as any).gtag?.("event", "appel_telephone", { boulangerie: shop });

      if (canDial) return; // mobile : on laisse le tel: composer

      e.preventDefault();
      const number = link.getAttribute("href")!.replace("tel:", "");
      const pretty = link.dataset.phone ?? number;
      try {
        await navigator.clipboard.writeText(pretty);
        showToast("Numéro copié : " + pretty);
      } catch {
        showToast("Appelez-nous au " + pretty);
      }
    });
  });

  // ── Mesure des clics itinéraire ──
  document.querySelectorAll<HTMLAnchorElement>("[data-itineraire]").forEach((link) => {
    link.addEventListener("click", () => {
      (window as any).gtag?.("event", "itineraire", {
        boulangerie: link.dataset.itineraire,
      });
    });
  });
</script>
