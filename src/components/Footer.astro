---
import { bakeries, SITE } from "../data/bakeries";

interface Props { current?: string }
const { current } = Astro.props;
const year = new Date().getFullYear();
---

<footer>
  <div class="footer-inner">
    <div class="footer-brand">
      <a href="/" class="serif footer-logo">MK <span class="footer-accent">Boulangeries</span></a>
      <p class="footer-tag">Trois boulangeries artisanales à Nantes et Saint-Herblain.</p>
      <nav class="footer-links" aria-label="Pages du site">
        <a href="/nos-produits">Nos produits</a>
        <a href="/commandes">Commandes sur mesure</a>
        <a href="/faq">Questions fréquentes</a>
        <a href="/mentions-legales">Mentions légales</a>
        <a href="/confidentialite">Confidentialité</a>
      </nav>
    </div>

    <nav class="footer-shops" aria-label="Nos boulangeries">
      {bakeries.map((b) => (
        <a href={`/${b.slug}`} class={`footer-shop ${b.slug === current ? "is-current" : ""}`}>
          <span class="footer-shop-name">{b.name}</span>
          <span class="footer-shop-meta">{b.street} · {b.postalCode} {b.city}</span>
          <span class="footer-shop-tel">{b.phone}</span>
        </a>
      ))}
    </nav>
  </div>

  <div class="footer-base">
    <span>© {year} {SITE.legalName} · Nantes &amp; Saint-Herblain</span>
    <span>Ouvert tous les jours de 6h à 20h, sauf le vendredi</span>
    <span class="footer-credit">
      Site conçu et réalisé par <a href="https://raythan.fr" target="_blank" rel="noopener">Raythan Web Design</a>
    </span>
  </div>
</footer>

<style>
  footer {
    background: var(--bg-deep);
    border-top: 1px solid var(--line);
    /* Dégage la barre d'appel collante sur mobile. */
    padding-bottom: 84px;
  }
  @media (min-width: 781px) { footer { padding-bottom: 0; } }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 64px 40px 40px;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 56px;
  }
  .footer-logo { font-size: 22px; font-weight: 600; }
  .footer-accent { color: var(--accent); font-style: italic; }
  .footer-tag {
    margin: 14px 0 20px;
    font-size: 14px;
    line-height: 1.7;
    color: var(--muted);
    max-width: 30ch;
  }
  .footer-links { display: flex; flex-direction: column; gap: 9px; }
  .footer-links a {
    font-size: 14px;
    color: var(--muted);
    width: fit-content;
    transition: color 0.2s ease-out;
  }
  .footer-links a:hover { color: var(--accent); }

  .footer-shops { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  .footer-shop {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    transition: border-color 0.25s ease-out;
  }
  .footer-shop:hover, .footer-shop.is-current { border-top-color: var(--accent); }
  .footer-shop-name { font-size: 15px; font-weight: 500; }
  .footer-shop-meta { font-size: 13px; line-height: 1.6; color: var(--muted); }
  .footer-shop-tel { font-size: 13px; color: var(--accent); }

  .footer-base {
    max-width: 1200px;
    margin: 0 auto;
    padding: 22px 40px 32px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    font-size: 13px;
    color: var(--muted);
  }

  /* Crédit agence. Lien suivi volontairement (rel sans nofollow) : c'est un
     lien éditorial légitime entre le site livré et son auteur. */
  .footer-credit a {
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease-out;
  }
  .footer-credit a:hover { color: var(--accent); }

  @media (max-width: 900px) {
    .footer-inner { grid-template-columns: 1fr; gap: 40px; }
    .footer-shops { grid-template-columns: 1fr; gap: 22px; }
  }
  @media (max-width: 600px) {
    .footer-inner { padding: 48px 24px 32px; }
    .footer-base { padding: 20px 24px 28px; }
  }
</style>
