---
import { SITE, whatsappUrl, smsUrl } from "../data/bakeries";

interface Props {
  /** Message pré-rempli. On indique la boutique pour éviter l'aller-retour. */
  message: string;
  shop?: string;
  compact?: boolean;
}

const { message, shop = "site", compact = false } = Astro.props;
---

<div class={`msg-group ${compact ? "is-compact" : ""}`}>
  <a
    href={whatsappUrl(message)}
    target="_blank"
    rel="noopener"
    class="msg-btn msg-wa"
    data-message={shop}
  >
    <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true">
      <path
        fill="currentColor"
        d="M17.5 14.4c-.3-.2-1.7-.9-2-1-.3-.1-.5-.1-.7.1l-.9 1.1c-.2.2-.4.2-.6.1a8.2 8.2 0 0 1-4-3.5c-.1-.3 0-.4.1-.6l.5-.6c.1-.2.2-.3.3-.5v-.5l-.9-2.2c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.1 1.1-1.1 2.7s1.2 3.1 1.3 3.3c.2.2 2.3 3.6 5.6 4.9 2.8 1.1 3.3.9 3.9.8.6-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5l-.7-.5ZM12 2a10 10 0 0 0-8.5 15.2L2 22l4.9-1.4A10 10 0 1 0 12 2Zm0 18.2c-1.6 0-3.2-.4-4.5-1.3l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Z"
      />
    </svg>
    <span>Écrire sur WhatsApp</span>
  </a>

  <a href={smsUrl(message)} class="msg-btn msg-sms" data-message={shop}>
    <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true">
      <path
        fill="currentColor"
        d="M20 2H4a2 2 0 0 0-2 2v18l4-4h14a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2Zm-6 11H7v-2h7v2Zm3-4H7V7h10v2Z"
      />
    </svg>
    <span>Par SMS</span>
  </a>
</div>

<p class="msg-note">Réponse aux heures d'ouverture · {SITE.contactMobile}</p>

<style>
  .msg-group {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .msg-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 48px;
    padding: 14px 26px;
    border-radius: 3px;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.3px;
    transition: background 0.25s ease-out, border-color 0.25s ease-out, color 0.25s ease-out;
  }
  .msg-wa {
    background: #25d366;
    color: #062813;
    border: 1px solid #25d366;
    font-weight: 600;
  }
  .msg-wa:hover { background: #34e07a; border-color: #34e07a; }
  .msg-sms {
    border: 1px solid rgba(240, 235, 224, 0.45);
    color: var(--ink);
  }
  .msg-sms:hover { border-color: var(--ink); background: rgba(240, 235, 224, 0.06); }

  .msg-note {
    margin: 14px 0 0;
    font-size: 13px;
    color: var(--muted);
  }

  .is-compact .msg-btn { padding: 12px 20px; font-size: 14px; min-height: 44px; }

  @media (max-width: 600px) {
    .msg-group { flex-direction: column; }
    .msg-btn { width: 100%; }
  }
</style>
