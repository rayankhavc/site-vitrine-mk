---
import type { Bakery } from "../data/bakeries";

interface Props { bakery: Bakery }
const { bakery } = Astro.props;

// Barre collante en bas d'écran sur mobile. Sur un site de boulangerie,
// l'action utile est un appel ou un itinéraire : elle reste à portée de
// pouce en permanence plutôt que d'obliger à remonter la page.
---

<div class="callbar">
  <a
    href={bakery.phoneHref}
    class="callbar-btn callbar-call"
    data-shop={bakery.slug}
    data-phone={bakery.phone}
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
      <path
        fill="currentColor"
        d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.3.2 2.5.57 3.6a1 1 0 0 1-.25 1l-2.2 2.2Z"
      />
    </svg>
    Appeler
  </a>
  <a
    href={bakery.mapsUrl}
    target="_blank"
    rel="noopener"
    class="callbar-btn callbar-map"
    data-itineraire={bakery.slug}
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
      <path
        fill="currentColor"
        d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"
      />
    </svg>
    Itinéraire
  </a>
</div>

<style>
  .callbar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 120;
    display: none;
    gap: 10px;
    padding: 10px 14px calc(10px + env(safe-area-inset-bottom));
    background: rgba(10, 14, 12, 0.94);
    backdrop-filter: blur(10px);
    border-top: 1px solid var(--line);
  }
  .callbar-btn {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 50px;
    border-radius: 4px;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.3px;
  }
  .callbar-call {
    background: var(--accent);
    color: var(--bg-deep);
  }
  .callbar-map {
    border: 1px solid rgba(240, 235, 224, 0.35);
    color: var(--ink);
  }

  /* Uniquement sur mobile : sur ordinateur le numéro est déjà dans la nav. */
  @media (max-width: 780px) {
    .callbar { display: flex; }
  }
</style>
